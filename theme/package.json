{
  "name": "ortus-docs-theme",
  "version": "1.0.0",
  "description": "Custom BxSites theme for Ortus Solutions documentation",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/input.css -o ./assets/style.css --minify",
    "watch:css": "tailwindcss -i ./assets/input.css -o ./assets/style.css --watch",
    "dev": "npm run watch:css"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0",
    "@tailwindcss/typography": "^0.5.10"
  },
  "private": true
}